//@version=5
// MSNR Monitor – pilnuje poziomów, zamknięć świec HTF (SBR/RBS) i BOS w strefie.
// Tryb AUTO: poziom 1 = ostatni szczyt (pivot) z H4, poziom 2 = ostatni dołek (pivot) z H4. Aktualizuje się sam, na żywo.
// Tryb RĘCZNY: wpisujesz poziomy sam w ustawieniach.
// To narzędzie edukacyjne, nie porada inwestycyjna. Nie składa zleceń.

indicator("MSNR Monitor", overlay = true, max_labels_count = 200)

// ===== Ustawienia =====
gM = "Tryb poziomów"
modeAuto = input.string("Auto (pivoty z H4)", "Tryb poziomów", options = ["Auto (pivoty z H4)", "Ręczne"], group = gM)
autoTf   = input.timeframe("240", "Interwał poziomów auto", group = gM)
pvLen    = input.int(3, "Długość pivota auto (świece z każdej strony)", minval = 1, group = gM)
isAuto   = modeAuto == "Auto (pivoty z H4)"

gL  = "Poziomy ręczne (w trybie Auto: aktywny tylko poziom 3)"
on1 = input.bool(true,  "Poziom 1 aktywny", group = gL)
L1  = input.price(4166.76, "Poziom 1", group = gL)
on2 = input.bool(true,  "Poziom 2 aktywny", group = gL)
L2  = input.price(4116.90, "Poziom 2", group = gL)
on3 = input.bool(false, "Poziom 3 aktywny", group = gL)
L3  = input.price(4217.70, "Poziom 3", group = gL)

gS      = "Zasady"
htfTf   = input.timeframe("60", "Interwał potwierdzenia poziomu (zamknięcie świecy)", group = gS)
zoneW   = input.float(4.0, "Połowa szerokości strefy (pkt)", minval = 0.1, group = gS)
lb      = input.int(36, "Ile świec wstecz szukać wejścia w strefę", minval = 3, group = gS)
pivLen  = input.int(2, "Długość pivota BOS (świece z każdej strony)", minval = 1, group = gS)
maxDist = input.float(25.0, "Maks. odległość dołka/szczytu BOS od poziomu (pkt)", minval = 1.0, group = gS)
showTbl = input.bool(true, "Pokaż tabelkę statusu", group = gS)

// ===== Poziomy auto z HTF (ostatni potwierdzony szczyt i dołek, bez repaintingu) =====
f_piv() =>
    float p1 = ta.pivothigh(high, pvLen, pvLen)
    float p2 = ta.pivotlow(low, pvLen, pvLen)
    float h = ta.valuewhen(not na(p1), p1, 0)
    float l = ta.valuewhen(not na(p2), p2, 0)
    [h[1], l[1]]

[autoH, autoL] = request.security(syminfo.tickerid, autoTf, f_piv(), lookahead = barmerge.lookahead_on)

useL1 = isAuto ? autoH : L1
useL2 = isAuto ? autoL : L2
useL3 = L3
e1 = isAuto ? not na(autoH) : on1
e2 = isAuto ? not na(autoL) : on2
e3 = on3

// ===== Pivoty BOS (ostatni dołek i szczyt na wykresie) =====
pl = ta.pivotlow(low, pivLen, pivLen)
ph = ta.pivothigh(high, pivLen, pivLen)
var float lastPL = na
var float lastPH = na
if not na(pl)
    lastPL := pl
if not na(ph)
    lastPH := ph

// ===== Zamknięcie świecy HTF =====
htfNew   = ta.change(time(htfTf)) != 0
htfClose = close[1]
tfOk     = timeframe.in_seconds() <= timeframe.in_seconds(htfTf)

// ===== Logika jednego poziomu =====
f_level(float L, bool on, float w, bool newHtf, float cHtf, int n, float pLow, float pHigh, float maxD) =>
    var int side = 0
    var float prevL = na
    bool brkUp = false
    bool brkDn = false
    // zmiana poziomu (np. nowy pivot auto) -> ustaw stronę według bieżącej ceny, bez alertu
    if not na(L) and (na(prevL) or L != prevL)
        side := close > L ? 1 : -1
        prevL := L
    else if on and newHtf and not na(L)
        int ns = cHtf > L ? 1 : -1
        brkUp := side == -1 and ns == 1
        brkDn := side == 1 and ns == -1
        side := ns
    float hh = ta.highest(high, n)
    float ll = ta.lowest(low, n)
    bool nearBelow = not na(L) and hh >= L - w and hh <= L + w
    bool nearAbove = not na(L) and ll <= L + w and ll >= L - w
    bool okLow  = not na(pLow) and not na(L) and pLow < L and L - pLow <= maxD
    bool okHigh = not na(pHigh) and not na(L) and pHigh > L and pHigh - L <= maxD
    bool sellSig = on and side == -1 and nearBelow and okLow and close < pLow and close[1] >= pLow
    bool buySig  = on and side == 1 and nearAbove and okHigh and close > pHigh and close[1] <= pHigh
    [side, brkUp, brkDn, sellSig, buySig]

[s1, bu1, bd1, sell1, buy1] = f_level(useL1, e1, zoneW, htfNew, htfClose, lb, lastPL, lastPH, maxDist)
[s2, bu2, bd2, sell2, buy2] = f_level(useL2, e2, zoneW, htfNew, htfClose, lb, lastPL, lastPH, maxDist)
[s3, bu3, bd3, sell3, buy3] = f_level(useL3, e3, zoneW, htfNew, htfClose, lb, lastPL, lastPH, maxDist)

// ===== Rysowanie poziomów i stref =====
f_col(int s) => s == -1 ? color.red : s == 1 ? color.green : color.gray

pU1 = plot(e1 ? useL1 + zoneW : na, "Strefa 1 góra", color = color.new(color.blue, 100))
pD1 = plot(e1 ? useL1 - zoneW : na, "Strefa 1 dół", color = color.new(color.blue, 100))
fill(pU1, pD1, color = color.new(f_col(s1), 85), title = "Strefa 1")
plot(e1 ? useL1 : na, "Poziom 1", color = color.blue, linewidth = 2)

pU2 = plot(e2 ? useL2 + zoneW : na, "Strefa 2 góra", color = color.new(color.blue, 100))
pD2 = plot(e2 ? useL2 - zoneW : na, "Strefa 2 dół", color = color.new(color.blue, 100))
fill(pU2, pD2, color = color.new(f_col(s2), 85), title = "Strefa 2")
plot(e2 ? useL2 : na, "Poziom 2", color = color.blue, linewidth = 2)

pU3 = plot(e3 ? useL3 + zoneW : na, "Strefa 3 góra", color = color.new(color.blue, 100))
pD3 = plot(e3 ? useL3 - zoneW : na, "Strefa 3 dół", color = color.new(color.blue, 100))
fill(pU3, pD3, color = color.new(f_col(s3), 85), title = "Strefa 3")
plot(e3 ? useL3 : na, "Poziom 3", color = color.blue, linewidth = 2)

anySell = sell1 or sell2 or sell3
anyBuy  = buy1 or buy2 or buy3
plotshape(anySell, title = "SELL", style = shape.triangledown, location = location.abovebar, color = color.red, size = size.normal, text = "SELL")
plotshape(anyBuy, title = "BUY", style = shape.triangleup, location = location.belowbar, color = color.green, size = size.normal, text = "BUY")

// ===== Alerty =====
f_brk(float L, bool up) =>
    syminfo.ticker + ": zamknięcie " + htfTf + " " + (up ? "NAD " : "POD ") + str.tostring(L, "#.##") + (up ? " -> RBS, czekaj na cofkę i BOS w górę" : " -> SBR, czekaj na cofkę i BOS w dół")

f_sig(float L, bool sell) =>
    syminfo.ticker + ": " + (sell ? "SIGNAL SELL" : "SIGNAL BUY") + " przy poziomie " + str.tostring(L, "#.##") + " (BOS " + (sell ? "w dół" : "w górę") + " w strefie). Sprawdź RR i SL."

if bu1
    alert(f_brk(useL1, true), alert.freq_once_per_bar)
if bd1
    alert(f_brk(useL1, false), alert.freq_once_per_bar)
if bu2
    alert(f_brk(useL2, true), alert.freq_once_per_bar)
if bd2
    alert(f_brk(useL2, false), alert.freq_once_per_bar)
if bu3
    alert(f_brk(useL3, true), alert.freq_once_per_bar)
if bd3
    alert(f_brk(useL3, false), alert.freq_once_per_bar)

if sell1
    alert(f_sig(useL1, true), alert.freq_once_per_bar_close)
if buy1
    alert(f_sig(useL1, false), alert.freq_once_per_bar_close)
if sell2
    alert(f_sig(useL2, true), alert.freq_once_per_bar_close)
if buy2
    alert(f_sig(useL2, false), alert.freq_once_per_bar_close)
if sell3
    alert(f_sig(useL3, true), alert.freq_once_per_bar_close)
if buy3
    alert(f_sig(useL3, false), alert.freq_once_per_bar_close)

// ===== Tabelka statusu =====
f_st(int s) => s == 1 ? "nad -> RBS (szukaj BUY)" : s == -1 ? "pod -> SBR (szukaj SELL)" : "czekam na zamknięcie " + htfTf

var table t = table.new(position.top_right, 2, 5, bgcolor = color.new(color.black, 20), border_width = 1)
if showTbl and barstate.islast
    table.cell(t, 0, 0, isAuto ? "Poziom (auto)" : "Poziom", text_color = color.white, text_size = size.small)
    table.cell(t, 1, 0, "Status", text_color = color.white, text_size = size.small)
    table.cell(t, 0, 1, e1 ? str.tostring(useL1, "#.##") : "-", text_color = color.white, text_size = size.small)
    table.cell(t, 1, 1, e1 ? f_st(s1) : "brak", text_color = f_col(s1), text_size = size.small)
    table.cell(t, 0, 2, e2 ? str.tostring(useL2, "#.##") : "-", text_color = color.white, text_size = size.small)
    table.cell(t, 1, 2, e2 ? f_st(s2) : "brak", text_color = f_col(s2), text_size = size.small)
    table.cell(t, 0, 3, e3 ? str.tostring(useL3, "#.##") : "-", text_color = color.white, text_size = size.small)
    table.cell(t, 1, 3, e3 ? f_st(s3) : "wyłączony", text_color = f_col(s3), text_size = size.small)
    table.cell(t, 0, 4, tfOk ? "" : "UWAGA", text_color = color.orange, text_size = size.small)
    table.cell(t, 1, 4, tfOk ? "" : "wykres większy niż interwał potwierdzenia", text_color = color.orange, text_size = size.small)
