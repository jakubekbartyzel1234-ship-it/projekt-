//@version=5
// MSNR (Malaysian SnR) Monitor
// - Poziomy A (szczyty) i V (dołki) liczone z ZAMKNIĘĆ świec (wykres liniowy) na wybranym interwale HTF (domyślnie H4).
// - Poziom jest ŚWIEŻY, dopóki nie dotknie go knot. Po dotknięciu jest NIEŚWIEŻY.
// - Zamknięcie korpusu poza poziomem = poziom przebity. Opcjonalnie zmienia rolę (RBS/SBR) i jest znów świeży.
// - Sygnał: knot wchodzi w ŚWIEŻY poziom i świeca zamyka się z powrotem po właściwej stronie
//   (A: SELL, V: BUY). Opcjonalnie tylko zgodnie z kierunkiem HTF (cena vs EMA).
// Nie ma tu jeszcze poziomów typu "gap". To narzędzie edukacyjne, nie porada inwestycyjna. Nie składa zleceń.

indicator("MSNR Malaysian SnR", overlay = true, max_lines_count = 200, max_labels_count = 200)

// ===== Ustawienia =====
gL      = "Poziomy (z zamknięć = wykres liniowy)"
lvTf    = input.timeframe("240", "Interwał poziomów A/V", group = gL)
pvN     = input.int(2, "Długość pivota na zamknięciach (świece z każdej strony)", minval = 1, group = gL)
maxLv   = input.int(12, "Maks. liczba poziomów po każdej stronie", minval = 2, group = gL)
flipOn  = input.bool(true, "Przebity poziom zmienia rolę (RBS/SBR) i jest znów świeży", group = gL)
tol     = input.float(0.3, "Tolerancja dotknięcia (pkt)", minval = 0.0, group = gL)

gB      = "Kierunek (storyline)"
useBias = input.bool(true, "Handluj tylko zgodnie z kierunkiem HTF (cena vs EMA)", group = gB)
biasTf  = input.timeframe("240", "Interwał kierunku", group = gB)
emaLen  = input.int(50, "Długość EMA kierunku", minval = 2, group = gB)

gT      = "Wygląd"
showTbl = input.bool(true, "Pokaż tabelkę", group = gT)

// ===== Poziomy A/V z HTF (bez repaintingu: wartości z zakończonej świecy HTF) =====
f_cpiv() =>
    float a = ta.pivothigh(close, pvN, pvN)
    float v = ta.pivotlow(close, pvN, pvN)
    [a[1], v[1]]

[hA, hV] = request.security(syminfo.tickerid, lvTf, f_cpiv(), lookahead = barmerge.lookahead_on)
newHtf = ta.change(time(lvTf)) != 0
tfOk   = timeframe.in_seconds() <= timeframe.in_seconds(lvTf)

f_bias() => close > ta.ema(close, emaLen) ? 1 : -1
bias = request.security(syminfo.tickerid, biasTf, f_bias())

// ===== Magazyn poziomów =====
var array<float> aLv = array.new_float()
var array<bool>  aFr = array.new_bool()
var array<float> vLv = array.new_float()
var array<bool>  vFr = array.new_bool()

f_add(array<float> lv, array<bool> fr, float x, int mx) =>
    array.push(lv, x)
    array.push(fr, true)
    if array.size(lv) > mx
        array.shift(lv)
        array.shift(fr)

if newHtf and not na(hA)
    f_add(aLv, aFr, hA, maxLv)
if newHtf and not na(hV)
    f_add(vLv, vFr, hV, maxLv)

// ===== Przetwarzanie świecy: dotknięcia, przebicia, sygnały =====
bool sellSig = false
bool buySig  = false
array<float> toV = array.new_float()   // przebite opory -> nowe wsparcia (RBS)
array<float> toA = array.new_float()   // przebite wsparcia -> nowe opory (SBR)

if array.size(aLv) > 0
    for i = array.size(aLv) - 1 to 0
        float L = array.get(aLv, i)
        if close > L
            array.remove(aLv, i)
            array.remove(aFr, i)
            array.push(toV, L)
        else if high >= L - tol
            if array.get(aFr, i) and close < L
                sellSig := true
            array.set(aFr, i, false)

if array.size(vLv) > 0
    for i = array.size(vLv) - 1 to 0
        float L = array.get(vLv, i)
        if close < L
            array.remove(vLv, i)
            array.remove(vFr, i)
            array.push(toA, L)
        else if low <= L + tol
            if array.get(vFr, i) and close > L
                buySig := true
            array.set(vFr, i, false)

if flipOn
    if array.size(toV) > 0
        for i = 0 to array.size(toV) - 1
            f_add(vLv, vFr, array.get(toV, i), maxLv)
    if array.size(toA) > 0
        for i = 0 to array.size(toA) - 1
            f_add(aLv, aFr, array.get(toA, i), maxLv)

okSell  = not useBias or bias == -1
okBuy   = not useBias or bias == 1
sellOut = sellSig and okSell
buyOut  = buySig and okBuy

plotshape(sellOut, title = "SELL", style = shape.triangledown, location = location.abovebar, color = color.red, size = size.normal, text = "SELL")
plotshape(buyOut, title = "BUY", style = shape.triangleup, location = location.belowbar, color = color.green, size = size.normal, text = "BUY")

if sellOut
    alert(syminfo.ticker + ": SELL – knot w świeży poziom A i zamknięcie pod nim. Sprawdź RR i SL.", alert.freq_once_per_bar_close)
if buyOut
    alert(syminfo.ticker + ": BUY – knot w świeży poziom V i zamknięcie nad nim. Sprawdź RR i SL.", alert.freq_once_per_bar_close)

// ===== Rysowanie poziomów (tylko na ostatniej świecy) =====
var array<line>  lns = array.new_line()
var array<label> lbs = array.new_label()
float nearA = na
float nearV = na
int freshCnt = 0

if barstate.islast
    if array.size(lns) > 0
        for ln in lns
            line.delete(ln)
        array.clear(lns)
    if array.size(lbs) > 0
        for lb in lbs
            label.delete(lb)
        array.clear(lbs)
    if array.size(aLv) > 0
        for i = 0 to array.size(aLv) - 1
            float L = array.get(aLv, i)
            bool fr = array.get(aFr, i)
            array.push(lns, line.new(bar_index, L, bar_index + 1, L, extend = extend.both, color = color.new(color.red, fr ? 0 : 55), style = fr ? line.style_solid : line.style_dotted, width = fr ? 2 : 1))
            array.push(lbs, label.new(bar_index + 2, L, "A " + str.tostring(L, "#.##") + (fr ? " świeży" : " nieświeży"), style = label.style_none, textcolor = color.new(color.red, fr ? 0 : 40), size = size.small))
            if fr
                freshCnt += 1
                if L > close and (na(nearA) or L < nearA)
                    nearA := L
    if array.size(vLv) > 0
        for i = 0 to array.size(vLv) - 1
            float L = array.get(vLv, i)
            bool fr = array.get(vFr, i)
            array.push(lns, line.new(bar_index, L, bar_index + 1, L, extend = extend.both, color = color.new(color.green, fr ? 0 : 55), style = fr ? line.style_solid : line.style_dotted, width = fr ? 2 : 1))
            array.push(lbs, label.new(bar_index + 2, L, "V " + str.tostring(L, "#.##") + (fr ? " świeży" : " nieświeży"), style = label.style_none, textcolor = color.new(color.green, fr ? 0 : 40), size = size.small))
            if fr
                freshCnt += 1
                if L < close and (na(nearV) or L > nearV)
                    nearV := L

// ===== Tabelka =====
var table t = table.new(position.top_right, 2, 5, bgcolor = color.new(color.black, 20), border_width = 1)
if showTbl and barstate.islast
    table.cell(t, 0, 0, "MSNR", text_color = color.white, text_size = size.small)
    table.cell(t, 1, 0, "Status", text_color = color.white, text_size = size.small)
    table.cell(t, 0, 1, "Kierunek HTF", text_color = color.white, text_size = size.small)
    table.cell(t, 1, 1, bias == 1 ? "w górę (BUY)" : "w dół (SELL)", text_color = bias == 1 ? color.green : color.red, text_size = size.small)
    table.cell(t, 0, 2, "Świeży A nad ceną", text_color = color.white, text_size = size.small)
    table.cell(t, 1, 2, na(nearA) ? "brak" : str.tostring(nearA, "#.##"), text_color = color.red, text_size = size.small)
    table.cell(t, 0, 3, "Świeży V pod ceną", text_color = color.white, text_size = size.small)
    table.cell(t, 1, 3, na(nearV) ? "brak" : str.tostring(nearV, "#.##"), text_color = color.green, text_size = size.small)
    table.cell(t, 0, 4, tfOk ? "Świeżych poziomów" : "UWAGA", text_color = tfOk ? color.white : color.orange, text_size = size.small)
    table.cell(t, 1, 4, tfOk ? str.tostring(freshCnt) : "wykres większy niż interwał poziomów", text_color = tfOk ? color.white : color.orange, text_size = size.small)
